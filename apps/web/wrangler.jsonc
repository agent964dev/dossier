{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dossier",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "dossier.agent964.com", "custom_domain": true },
    {
      "pattern": "*.dossier-content.com/*",
      "zone_name": "dossier-content.com",
    },
  ],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/_/app/*", "/_/base/*"],
    // Base-layer files keep their names: _layout.html is never a pretty URL.
    "html_handling": "none",
  },
  // Secrets in every environment: BETTER_AUTH_SECRET, HANDLE_SECRET,
  // SUPER_ADMINS, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
  "vars": {
    "PUBLIC_ORIGIN": "https://dossier.agent964.com",
    "DEPLOYMENT_NAME": "dossier.agent964.com",
    "CONTENT_HOST": "{tree}.dossier-content.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dossier-next-production",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "dossier-next-production" },
  ],
  // One hub per tree relays change hints to the sockets watching it.
  "durable_objects": {
    "bindings": [{ "name": "TREE_HUB", "class_name": "TreeHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TreeHub"] }],
  // The weekly purge: Sunday 03:17 UTC.
  "triggers": { "crons": ["17 3 * * SUN"] },
  "env": {
    "dev": {
      "name": "dossier-next-dev",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "*-dev.dossier-content.com/*",
          "zone_name": "dossier-content.com",
        },
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://dossier-next-dev.tech964.workers.dev",
        "DEPLOYMENT_NAME": "dossier-next-dev.tech964.workers.dev",
        "CONTENT_HOST": "{tree}-dev.dossier-content.com",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dossier-next-dev",
          "database_id": "70b42e29-2b9a-434d-b2a5-920137c7fea9",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "dossier-next-dev" }],
      "durable_objects": {
        "bindings": [{ "name": "TREE_HUB", "class_name": "TreeHub" }],
      },
      "triggers": { "crons": ["17 3 * * SUN"] },
    },
  },
}
