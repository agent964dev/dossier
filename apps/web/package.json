{
  "name": "@dossier/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "db:generate": "drizzle-kit generate",
    "dev": "CLOUDFLARE_ENV=dev vite dev",
    "fonts:catalogue": "bun scripts/google-fonts.ts",
    "dev:https": "CLOUDFLARE_ENV=dev vite build && bun scripts/local-config.ts && wrangler dev --config dist/server/wrangler.local.json --persist-to .wrangler/state --local-protocol https --port 8787 --https-key-path ../../.certs/localhost-key.pem --https-cert-path ../../.certs/localhost.pem",
    "deploy:dev": "CLOUDFLARE_ENV=dev vite build && bun scripts/copy-base.ts --bucket dossier-next-dev --env dev && wrangler d1 migrations apply dossier-next-dev --remote --env dev --config wrangler.jsonc && wrangler deploy --env dev",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-interface Env --strict-vars=false"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@dossier/contracts": "workspace:*",
    "@dossier/html": "workspace:*",
    "@effect/platform": "0.97.2",
    "@pierre/diffs": "1.5.2",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.2",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/vitest-plugin": "1.1.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/culori": "4.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "1.7.7",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.10",
    "happy-dom": "20.14.6",
    "standardwebhooks": "1.1.1",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
