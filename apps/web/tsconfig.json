{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/vitest-plugin/types",
      "vite/client",
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["src/runtime"],
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "worker-configuration.d.ts"
  ]
}
