{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".output",
    "drizzle",
    "apps/web/worker-configuration.d.ts",
    "**/routeTree.gen.ts",
    "upstream/**",
    "packages/policy/test/fixtures/**",
    "docs/**/*.html",
    // The base layout goes into every page as written; tests pin its bytes.
    "packages/browser/src/base/_layout.html",
    // The Look's golden stylesheet is compared byte for byte.
    "apps/web/test/fixtures/*.golden.txt",
  ],
}
