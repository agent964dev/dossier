{
  "name": "@agent964/dossier",
  "version": "1.0.0",
  "description": "Push, pull and read Dossier trees, and sign in agents, from the command line.",
  "type": "module",
  "bin": {
    "dossier": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agent964dev/dossier.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/agent964dev/dossier#readme",
  "license": "MIT",
  "scripts": {
    "prebuild": "cp ../../LICENSE LICENSE",
    "build": "bun build src/index.ts --target=node --outfile dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "bun run build && npm publish"
  },
  "dependencies": {
    "@effect/cli": "0.77.1",
    "@effect/platform": "0.97.2",
    "@effect/platform-node": "0.108.2",
    "effect": "3.22.2"
  },
  "devDependencies": {
    "@dossier/contracts": "workspace:*",
    "@dossier/html": "workspace:*",
    "ignore": "7.0.12"
  }
}
