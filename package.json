{
  "name": "dossier",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "dev": "bun --filter '*' dev",
    "deploy:dev": "bun --filter '*' deploy:dev",
    "lint": "oxlint --ignore-path .gitignore .",
    "lint:fix": "oxlint --ignore-path .gitignore --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@types/node": "22.20.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "oxlint": "1.82.0",
    "oxfmt": "0.67.0"
  },
  "packageManager": "bun@1.3.14",
  "version": "1.0.0",
  "description": "![CI](https://github.com/agent964dev/dossier/actions/workflows/ci.yml/badge.svg)",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
